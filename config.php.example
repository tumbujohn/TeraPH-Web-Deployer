<?php
// =============================================================================
// TeraPH Web Deployer — Configuration Template
// =============================================================================
// Copy this file to config.php and fill in all values.
// NEVER commit config.php to version control.
// =============================================================================

// ---- Application ----
define('APP_NAME', 'TeraPH Deployer');
define('APP_URL', 'https://yourdomain.com/deployer'); // No trailing slash

// ---- Authentication ----
define('APP_USERNAME', 'admin');
// Generate with: php -r "echo password_hash('yourpassword', PASSWORD_BCRYPT);"
define('APP_PASSWORD_HASH', '');

// ---- Session ----
define('SESSION_NAME', 'tera_deployer_session');
define('SESSION_TIMEOUT', 3600); // Idle timeout in seconds (default: 60 minutes)

// ---- Database ----
define('DB_DRIVER', 'sqlite'); // 'sqlite' or 'mysql'
define('DB_PATH',  __DIR__ . '/storage/deployer.db'); // SQLite only
define('DB_HOST',  'localhost');  // MySQL only
define('DB_PORT',  '3306');       // MySQL only
define('DB_NAME',  'deployer');   // MySQL only
define('DB_USER',  'root');       // MySQL only
define('DB_PASS',  '');           // MySQL only

// ---- Storage ----
define('STORAGE_PATH', __DIR__ . '/storage');
define('BACKUP_PATH',  __DIR__ . '/storage/backups');
define('TMP_PATH',     __DIR__ . '/storage/tmp');
define('LOG_PATH',     __DIR__ . '/storage/logs');

// ---- Deployment ----
define('MAX_BACKUPS_PER_PROJECT', 10);   // Backups to retain per project
define('DOWNLOAD_TIMEOUT',        300);  // cURL download timeout (seconds)
define('LOCK_TIMEOUT',            1200); // Stale lock auto-release (seconds)
define('HOOK_TIMEOUT',            300);  // Max seconds for a single deploy hook command

// Password-protect .env files inside backup zips (AES-256, key derived from
// SECRET_KEY). Default false: backups hold .env as plain text, so anyone who
// can read storage/backups/ can read your secrets. Restore works either way.
// Needs PHP 7.2+ / libzip 1.2+. Changing SECRET_KEY orphans encrypted .env files.
define('BACKUP_ENCRYPT_ENV', false);

// Permission mode of the managed .env the .env Manager writes. 0640 = owner read/write, group
// read, nothing for other users on a shared host. If the web server runs as a different user
// than the one running the deployer (for example deploys started from SSH as another user) and
// your app can't read .env after a deploy, set 0644. Installs whose config.php lacks this line
// keep the older 0644 behavior.
define('ENV_FILE_MODE', 0640);

// PHP CLI binary used by deploy hooks and the web terminal (composer, php artisan, ...) for projects that
// don't set their own. Hooks run as child processes of the web server, so a bare `php` is whatever the web
// server's PATH finds — often a different (older) PHP than your site runs on; cPanel and DirectAdmin install
// one CLI per PHP version.
//   ''        automatic (default): use the CLI of the PHP that runs this site when `php` on PATH is a
//             different version; otherwise leave PATH alone
//   '/path'   always use this binary, e.g. '/opt/cpanel/ea-php84/root/usr/bin/php' or '/usr/local/php84/bin/php'
//   'system'  never override: use whatever `php` the web server's PATH finds (the behavior before this existed)
// Each project can also pick its own PHP binary in its settings, which wins over this. Settings shows
// which PHP hooks use and lists the PHP binaries found on this host.
define('CLI_PHP_PATH', '');

// ---- Deploy Strategy ----
// 'auto'    → detect symlink capability on first deploy and cache the result
// 'symlink' → force symlink mode (requires webroot to point at target/current)
// 'copy'    → always use enhanced copy-in-place (safe default for shared hosting)
define('DEPLOY_STRATEGY', 'auto');

// ---- Deployer Root ----
// Absolute path to the deployer installation root. Used by the self-protection
// guard to prevent the deployer from deleting itself during a deployment.
// Set this manually if dirname(__DIR__) does not point to the correct location.
define('DEPLOYER_ROOT', dirname(__DIR__));

// ---- Terminal ----
define('TERMINAL_ENABLED', true);  // Set false to disable the web terminal site-wide
define('TERMINAL_TIMEOUT', 600);   // Max seconds a single terminal command may run

// ---- Security ----
// Used to encrypt per-project .env variable values stored in the database.
// Generate with: php -r "echo bin2hex(random_bytes(32));"
// WARNING: Changing this key will invalidate all stored .env values.
define('SECRET_KEY', '');

// ---- GitHub ----
// Optional: personal access token for private repositories
define('GITHUB_PAT', '');

// ---- Webhook (Phase 2) ----
define('WEBHOOK_SECRET', ''); // HMAC-SHA256 shared secret

// ---- Development ----
// Set to true on local/dev machines to bypass SSL certificate verification.
// NEVER set this to true in production — it disables HTTPS security.
define('DEV_MODE',        false);
define('CURL_SSL_VERIFY', !DEV_MODE);
